# syntax=docker/dockerfile:1.7
# Imagen de PRUEBAS del front del ERP, para el VPS de testing (Ubuntu, Contabo).
#
# Este front habla con su API por el REWRITE de `next.config.ts`, no directamente: el navegador
# llama siempre al mismo origen que le sirve la página, y el servidor de Next reenvía a
# `ERP_API_ORIGIN`. Eso tiene dos consecuencias que hay que respetar aquí, y ninguna es evidente:
#
#   1. `ERP_API_ORIGIN` se HORNEA en el rewrite al construir. El default del `.env.local`
#      (`127.0.0.1:3007`) dentro del contenedor es el PROPIO contenedor, no el ERP: el proxy
#      devolvería ECONNREFUSED en cada llamada. En el VPS tiene que ser el nombre del servicio de
#      Docker (`http://atlas-erp-backend:3007`), que sí resuelve desde dentro de la red.
#
#   2. `NEXT_PUBLIC_ATLAS_API_BASE_URL` tiene que quedar VACÍA. Vacía es como se le dice al cliente
#      «habla con el mismo origen que te sirve» y use el proxy. Si llega sin definir, el cliente cae
#      al origen por defecto: el front compila igual y apunta a otro sitio.
#
# Construcción:
#   docker build -f Dockerfile.dev \
#     --build-arg ERP_API_ORIGIN=http://atlas-erp-backend:3007 \
#     -t atlas-erp-frontend:dev .

FROM node:22-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

FROM base AS dependencies
COPY package.json yarn.lock ./
# `--network-timeout` y `--network-concurrency` NO son adorno en este VPS.
#
# Los tres portales se despliegan a veces a la vez, y cada uno resuelve su árbol entero con
# `--no-cache`. Medido en un despliegue real: con los tres en paralelo y el swap ya al 83 %, este
# mismo `yarn install` tardó ONCE MINUTOS y murió con `exit code: 1` — la máquina estaba paginando,
# no había un problema de dependencias (el mismo build en solitario resuelve en menos de un
# minuto). El error no menciona la memoria por ninguna parte.
#
# El timeout largo evita que una descarga lenta se dé por perdida; la concurrencia baja reduce las
# conexiones simultáneas y con ellas el pico de memoria y de E/S. Ninguna de las dos arregla
# desplegar tres portales a la vez —eso se arregla desplegándolos de uno en uno— pero suben mucho
# el listón antes de que la lentitud se convierta en fallo.
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn,sharing=locked \
    yarn install --frozen-lockfile --network-timeout 600000 --network-concurrency 4

FROM base AS builder
# El origen al que reenvía el SERVIDOR de Next. Aquí sí vale un nombre de servicio de Docker: quien
# hace esta llamada es el contenedor, no el navegador.
ARG ERP_API_ORIGIN=http://atlas-erp-backend:3007
ARG NEXT_PUBLIC_ATLAS_API_PREFIX=api/v1
ARG NEXT_PUBLIC_ATLAS_DEFAULT_PAGE_SIZE=25
ENV ERP_API_ORIGIN=$ERP_API_ORIGIN \
    NEXT_PUBLIC_ATLAS_API_PREFIX=$NEXT_PUBLIC_ATLAS_API_PREFIX \
    NEXT_PUBLIC_ATLAS_DEFAULT_PAGE_SIZE=$NEXT_PUBLIC_ATLAS_DEFAULT_PAGE_SIZE \
    NEXT_PUBLIC_ATLAS_API_BASE_URL=
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN yarn build
# Este front no tiene `public/`. La copia de más abajo es incondicional —Docker no sabe copiar «si
# existe»— así que se garantiza el directorio aquí.
RUN mkdir -p public

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  HOSTNAME=0.0.0.0 \
  PORT=3010

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3010
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/" || exit 1
CMD ["node", "server.js"]
