    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "resolutions": {
