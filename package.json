{
  "name": "atlas-erp-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Next.js 15 para acoplar vistas ATLAS ERP al backend integrado.",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "type-check": "tsc --noEmit",
    "test:auth": "node --test tests/auth-session.test.mjs",
    "test:unit": "vitest run",
    "lint": "node scripts/check-pestanas-accion.mjs && node scripts/check-campos.mjs && node scripts/check-ayuda.mjs && eslint . --max-warnings=0",
    "check": "npm run type-check && npm run lint && npm run test:auth && npm run test:unit && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PW_SOLO_SIMULADO=1 playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "next": "15.5.23",
    "postcss": "^8.5.26",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "jsdom": "26.1.0",
    "typescript": "^5.7.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "resolutions": {
    "brace-expansion": "^2.0.2",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
