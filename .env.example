# Único backend al que este frontend habla directamente: atlas-integrated-backend (puerto 3000).
# Sirve Contabilidad, CRM B2B, Ads, Auditoría, y — desde la Fase 1 del gateway de auth — también
# /auth/* (login/usuarios/roles/permisos), que ese backend reenvía internamente hacia AtlasBackend
# (puerto 3005). El frontend nunca habla con AtlasBackend de forma directa.
# Envelope de respuesta: { success, data } / { success: false, error }.
# Vacía: el navegador llama a su propio origen y `next.config.ts` reescribe /api/v1/* hacia el
# backend (ERP_API_ORIGIN). Con una URL absoluta el navegador llama a OTRO origen, y el preflight de
# CORS exige que el backend permita cada cabecera propia (x-correlation-id, x-atlas-flow,
# x-atlas-product); antes de que las permitiera, esta línea rompía todas las peticiones.
NEXT_PUBLIC_ATLAS_API_BASE_URL=
ERP_API_ORIGIN=http://127.0.0.1:3007
NEXT_PUBLIC_ATLAS_API_PREFIX=api/v1
NEXT_PUBLIC_ATLAS_DEFAULT_PAGE_SIZE=25

# Este frontend corre en el puerto 3010 (ver script "dev" en package.json) porque el 3000 ya lo
# usa atlas-integrated-backend. Si cambias el puerto, agrégalo también a CORS_ALLOWED_ORIGINS
# en el .env de atlas-integrated-backend.

# Portal del Motor de Decisión: sólo para ENLAZAR desde la cola de onboarding a la ejecución del KYB
# y al caso de revisión manual. Vacío = no se pintan los enlaces.
NEXT_PUBLIC_DECISION_ENGINE_URL=
